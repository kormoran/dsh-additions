{
  "name": "dsh-additions",
  "version": "0.10.0",
  "description": "Additions for DeepSeek Harness: /quit, /rename, notification sounds with a settings page, workspace statistics, and moving a chat to another workspace.",
  "author": "Massimo Soricetti <massimo.soricetti@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/move.js",
    "lib/quit.js",
    "lib/rename.js",
    "lib/sounds.js",
    "lib/workspace-stats.js",
    "assets/ding.wav",
    "assets/uh-oh.wav",
    "locale/en.json",
    "locale/zh.json",
    "locale/ja.json",
    "locale/es.json",
    "locale/fr.json",
    "locale/de.json",
    "locale/ru.json",
    "locale/pt.json",
    "locale/it.json",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "command",
    "slash-command",
    "quit",
    "rename",
    "shutdown",
    "workspace",
    "session",
    "chat",
    "move",
    "fork",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kormoran/dsh-additions.git"
  },
  "homepage": "https://github.com/kormoran/dsh-additions#readme",
  "bugs": {
    "url": "https://github.com/kormoran/dsh-additions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"tests/*.test.js\"",
    "pack": "npm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
