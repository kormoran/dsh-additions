{
  "name": "dsh-chatshifter",
  "version": "0.2.0",
  "description": "Move a DeepSeek Harness chat to another workspace, carrying its history with it.",
  "author": "Massimo Soricetti <massimo.soricetti@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "workspace",
    "session",
    "chat",
    "move",
    "fork",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kormoran/dsh-chatshifter.git"
  },
  "homepage": "https://github.com/kormoran/dsh-chatshifter#readme",
  "bugs": {
    "url": "https://github.com/kormoran/dsh-chatshifter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-isolation=none tests/",
    "pack": "npm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
